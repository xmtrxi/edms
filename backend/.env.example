APP_ENV=development
APP_PORT=8080
CORS_ORIGIN=*
JWT_SECRET=

SURREALDB_URL=
SURREALDB_NAMESPACE=edms
SURREALDB_DATABASE=edms
SURREALDB_USER=
SURREALDB_PASS=

REDIS_URL=

# Storage — S3 / MinIO (the only supported provider)
STORAGE_PROVIDER=s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=edms-documents
S3_USE_PATH_STYLE=true

SIGNING_ENABLED=false
SIGNING_PROVIDER=documenso
DOCUMENSO_BASE_URL=
DOCUMENSO_API_KEY=

# Hybrid AI classification (rules → embeddings → LLM via SpaceXAI / xAI)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.5
XAI_EMBEDDING_MODEL=grok-embedding-small
AI_ENABLE_EMBEDDINGS=true
AI_ENABLE_LLM=true
