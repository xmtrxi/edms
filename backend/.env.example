APP_ENV=development
APP_PORT=8080

# Deployment: "selfhosted" runs one organization (invite-only);
# "saas" allows open signup, personal workspaces and many organizations.
EDMS_MODE=selfhosted
# open | invite  (defaults: saas=open, selfhosted=invite)
#EDMS_SIGNUP=invite
# Self-hosted: name of the organization created on first start.
EDMS_ORG_NAME=
# Self-hosted: first administrator; a setup link is logged on first start.
EDMS_ADMIN_EMAIL=
#EDMS_PERSONAL_WORKSPACES=false
#EDMS_MULTI_ORG=false
CORS_ORIGIN=*
JWT_SECRET=

SURREALDB_URL=
SURREALDB_NAMESPACE=edms
SURREALDB_DATABASE=edms
SURREALDB_USER=
SURREALDB_PASS=

REDIS_URL=
VALKEY_URL=
QUEUE_CONCURRENCY=10
OCR_PROVIDER=docling

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/files

S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=

DOCLING_BASE_URL=http://localhost:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT=600s
GOTENBERG_BASE_URL=http://localhost:3000

MEILI_URL=
MEILI_MASTER_KEY=
MEILI_INDEX=documents

# Built-in e-signatures are always on. Completed documents are sealed with
# this certificate and key (PEM); without them a self-signed seal is created
# and kept in storage. ESIGN_TSA_URL adds a trusted timestamp.
ESIGN_SEAL_CERT_FILE=
ESIGN_SEAL_KEY_FILE=
ESIGN_SEAL_NAME=Lumen DMS
ESIGN_TSA_URL=

# Optional: Documenso instead of the built-in signing.
SIGNING_ENABLED=false
SIGNING_PROVIDER=documenso
DOCUMENSO_BASE_URL=
DOCUMENSO_API_KEY=

# Editing in the browser with ONLYOFFICE Docs. All three of URL, API URL and
# JWT secret are needed; the secret must match ONLYOFFICE's JWT_SECRET.
# ONLYOFFICE_URL is where browsers load it; ONLYOFFICE_API_URL is where
# ONLYOFFICE reaches this API (with /api); ONLYOFFICE_INTERNAL_URL is where
# this API reaches ONLYOFFICE when that differs from ONLYOFFICE_URL.
ONLYOFFICE_URL=
ONLYOFFICE_API_URL=
ONLYOFFICE_INTERNAL_URL=
ONLYOFFICE_JWT_SECRET=

# Optional AI adapter. Keep these provider-neutral; an adapter maps them to
# the chosen hosted or local model service.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
